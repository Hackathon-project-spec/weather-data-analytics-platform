# SIH26069 Weather Platform Backend Configuration
# Ministry of Earth Sciences (MoES) Prototype

# --- Kafka Event Backbone ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_LISTENER_ENABLED=true

# --- PostgreSQL Relational Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/weather_platform
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# --- ClickHouse OLAP Time-Series Database ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=weather_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=jdbc:ch://localhost:8123/weather_db

# --- Redis Low-Latency Cache ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- Microservice URLs (Used by API Gateway) ---
INGESTION_SERVICE_URL=http://localhost:8081
CITIZEN_SERVICE_URL=http://localhost:8082
VERIFICATION_SERVICE_URL=http://localhost:8083
ANALYTICS_SERVICE_URL=http://localhost:8084
GATEWAY_SERVICE_URL=http://localhost:8080

# --- Ports ---
PORT_GATEWAY=8080
PORT_INGESTION=8081
PORT_CITIZEN=8082
PORT_VERIFICATION=8083
PORT_ANALYTICS=8084
PORT_FRONTEND=3000
